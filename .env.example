DATABASE_URL=postgresql+asyncpg://vaalikone:vaalikone@localhost:5435/vaalikone
REDIS_URL=redis://localhost:6382/0
# LLM: mikä tahansa LiteLLM-provideri. Esimerkkejä:
#   OpenAI:  LLM_API_KEY_ENV=OPENAI_API_KEY   DEFAULT_LLM_MODEL=gpt-6-luna
#   Mistral: LLM_API_KEY_ENV=MISTRAL_API_KEY  DEFAULT_LLM_MODEL=mistral/mistral-small-latest
#   Oma gateway: LLM_API_BASE=https://oma-gateway.example.com/v1
# Vanha OPENAI_API_KEY toimii yhä fallbackina jos LLM_API_KEY ei asetettu.
# LLM_API_KEY=sk-your-key-here
# LLM_API_KEY_ENV=OPENAI_API_KEY
# LLM_API_BASE=
OPENAI_API_KEY=sk-your-key-here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gpt-6-luna
DEFAULT_EMBED_MODEL=ollama/bge-m3

# Valinnainen: jos asetettu, kaikki /api/v1/* -päätteet vaativat X-API-Key -headerin
# VAALIKONE_API_KEY=satunnainen-salainen
# Sallitut chat-mallit pilkulla erotettuna (tyhjä = vain DEFAULT_LLM_MODEL + __text_only__)
# CHAT_ALLOWED_MODELS=gpt-6-luna,gpt-6.1-terra,gpt-6.2-sol,__text_only__

# Eduskunnan avoimen datan osoitteet (vanha palvelu siirtyy uuteen 2027 alusta)
# EDUSKUNTA_API_URL=https://avoindata.eduskunta.fi
# EDUSKUNTA_SEARCH_URL=https://api.eduskunta.fi

KEYCLOAK_ENABLED=false
KEYCLOAK_URL=http://localhost:8083

# Docker Compose -salasanat (kehityksessä oletukset käyvät)
# POSTGRES_USER=vaalikone
# POSTGRES_PASSWORD=vaalikone
# POSTGRES_DB=vaalikone
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
